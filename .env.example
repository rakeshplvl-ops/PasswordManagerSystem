# ==============================================================================
# Enterprise Password Manager - Environment Configuration Template
# Copy this file to .env and configure secret values for production deployment
# ==============================================================================

# Database Configuration
POSTGRES_DB=passwordmanager_db
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=replace_with_strong_random_secret_in_production
POSTGRES_PORT=5432

# Application API Configuration
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# Frontend Web Application Configuration
WEB_PORT=3000

# Automated Backup Settings
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
DB_CONTAINER=passwordmanager-db
